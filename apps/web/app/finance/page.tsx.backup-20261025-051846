function ExpenseTable({ expenses, currency = "INR" }: { expenses: Expense[]; currency?: string }) {
  if (!expenses.length) return <Empty text="No expenses in this period." />;

  return (
    <div className="overflow-x-auto">
      <table className="w-full text-left text-sm">
        <thead>
          <tr className="border-b border-slate-100 text-xs text-slate-400">
            <th className="py-3 pr-4 font-medium">Expense</th>
            <th className="py-3 pr-4 font-medium">Date</th>
            <th className="py-3 pr-4 font-medium">Method</th>
            <th className="py-3 font-medium">Amount</th>
          </tr>
        </thead>
        <tbody>
          {expenses.map((expense) => (
            <tr key={expense.id} className="border-b border-slate-50 last:border-0">
              <td className="py-3 pr-4">
                <div className="font-semibold capitalize text-slate-800">
                  {expense.description}
                </div>
                <div className="mt-1 text-xs capitalize text-slate-400">
                  {expense.category}
                </div>
              </td>
              <td className="whitespace-nowrap py-3 pr-4 text-slate-500">
                {dateLabel(expense.incurred_at)}
              </td>
              <td className="py-3 pr-4 capitalize text-slate-600">
                {expense.payment_method?.replaceAll("_", " ") || "—"}
              </td>
              <td className="whitespace-nowrap py-3 font-semibold text-slate-800">
                {money(expense.amount, currency)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
