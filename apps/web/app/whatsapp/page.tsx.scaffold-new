"use client";
import { useState } from "react";
import { Panel, Stat, Pill, WorkspacePage } from "@/components/ai-os/WorkspacePage";
const defaults=[{id:1,name:"Appointment confirmation",trigger:"Booking confirmed",desc:"Send only after booking succeeds.",enabled:true},{id:2,name:"Appointment reminder",trigger:"Before appointment",desc:"Use an approved template at the configured time.",enabled:true},{id:3,name:"Post-visit follow-up",trigger:"Visit completed",desc:"Send clinic-approved follow-up content.",enabled:false},{id:4,name:"Staff handover",trigger:"AI needs help",desc:"Create a follow-up task for staff.",enabled:true}];
export default function Page(){const [rules,setRules]=useState(defaults);const [msg,setMsg]=useState("");return <WorkspacePage title="WhatsApp Automation" description="Configure confirmations, reminders, patient follow-ups and staff handover workflows."><div className="grid gap-4 sm:grid-cols-3"><Stat label="Rules" value={String(rules.length)}/><Stat label="Enabled (demo)" value={String(rules.filter(x=>x.enabled).length)}/><Stat label="WhatsApp connection" value="Not connected"/></div>{msg&&<p className="rounded-lg bg-blue-50 p-3 text-sm text-blue-800">{msg}</p>}<Panel title="Automation rules"><div className="space-y-3">{rules.map(r=><div key={r.id} className="flex flex-col justify-between gap-3 rounded-xl border p-4 sm:flex-row sm:items-center"><div><p className="font-semibold">{r.name}</p><div className="my-1"><Pill>{r.trigger}</Pill></div><p className="text-sm text-slate-600">{r.desc}</p></div><button onClick={()=>{setRules(rules.map(x=>x.id===r.id?{...x,enabled:!x.enabled}:x));setMsg("Changed local demo state only; no WhatsApp message was sent.");}} className="rounded-lg border px-3 py-2 text-sm">{r.enabled?"Disable":"Enable"}</button></div>)}</div></Panel><Panel title="Production checklist"><ul className="list-disc space-y-2 pl-5 text-sm text-slate-600"><li>Connect official WhatsApp Business Platform or supported provider.</li><li>Use approved templates where required and respect messaging windows.</li><li>Respect consent and opt-outs.</li><li>Record sent, delivered, read and failed statuses from webhooks.</li><li>Use idempotent jobs to prevent duplicate reminders.</li></ul></Panel></WorkspacePage>}
