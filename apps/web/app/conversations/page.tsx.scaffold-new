"use client";
import { useState } from "react";
import { Panel, Pill, WorkspacePage } from "@/components/ai-os/WorkspacePage";
const seed=[{id:1,name:"Demo patient A",status:"Needs staff",preview:"Can I reschedule?",messages:[["Patient","Can I reschedule my appointment?"],["AI","I will check valid available times and confirm only after the appointment system updates."]]},{id:2,name:"Demo patient B",status:"AI handling",preview:"What are your hours?",messages:[["Patient","What are your opening hours?"],["AI","The clinic's approved hours will be shown once the Knowledge Base is connected."]]}];
export default function Page(){const [threads,setThreads]=useState(seed);const [activeId,setActiveId]=useState(1);const [q,setQ]=useState("");const [draft,setDraft]=useState("");const [msg,setMsg]=useState("");const active=threads.find(t=>t.id===activeId);const filtered=threads.filter(t=>(t.name+t.preview+t.status).toLowerCase().includes(q.toLowerCase()));function send(){if(!active||!draft.trim())return;setThreads(threads.map(t=>t.id===active.id?{...t,messages:[...t.messages,["Staff (demo)",draft]],preview:draft,status:"Staff handling"}:t));setDraft("");setMsg("Message was added to demo state only; it was not sent to WhatsApp.");}return <WorkspacePage title="Conversations Inbox" description="Review WhatsApp threads, hand over to staff and connect conversations to patient and appointment records.">{msg&&<p className="rounded-lg bg-blue-50 p-3 text-sm text-blue-800">{msg}</p>}<div className="grid gap-4 lg:grid-cols-[320px_1fr]"><Panel title="Conversations"><input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search conversations" className="mb-3 w-full rounded-lg border px-3 py-2"/><div className="space-y-2">{filtered.map(t=><button key={t.id} onClick={()=>setActiveId(t.id)} className={`w-full rounded-xl border p-3 text-left ${activeId===t.id?"border-slate-900 bg-slate-50":"border-slate-200"}`}><p className="font-medium">{t.name}</p><p className="text-sm text-slate-600">{t.preview}</p><div className="mt-2"><Pill>{t.status}</Pill></div></button>)}</div></Panel><Panel title={active?.name??"Conversation"}>{active&&<><div className="mb-3 flex gap-2"><button onClick={()=>{setThreads(threads.map(t=>t.id===active.id?{...t,status:"Staff handling"}:t));setMsg("Staff handover changed in demo only.");}} className="rounded-lg border px-3 py-2 text-sm">Take over</button><button onClick={()=>{setThreads(threads.map(t=>t.id===active.id?{...t,status:"AI handling"}:t));setMsg("AI state changed in demo only.");}} className="rounded-lg border px-3 py-2 text-sm">Resume AI</button></div><div className="space-y-2">{active.messages.map((m,i)=><div key={i} className={`max-w-[85%] rounded-xl p-3 ${m[0]==="Patient"?"bg-slate-100":"ml-auto bg-blue-50"}`}><p className="text-xs font-semibold text-slate-500">{m[0]}</p><p className="text-sm">{m[1]}</p></div>)}</div><div className="mt-4 flex gap-2"><input value={draft} onChange={e=>setDraft(e.target.value)} onKeyDown={e=>e.key==="Enter"&&send()} placeholder="Write a staff reply..." className="min-w-0 flex-1 rounded-lg border px-3 py-2"/><button onClick={send} className="rounded-lg bg-slate-900 px-4 py-2 text-white">Add</button></div></>}</Panel></div></WorkspacePage>}
