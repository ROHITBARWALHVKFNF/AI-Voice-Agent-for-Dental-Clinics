
"use client";

import AppShell from "@/components/layout/AppShell";
import { useMemo, useRef, useState } from "react";
import {
  Activity,
  ArrowUpRight,
  BookOpen,
  Check,
  ChevronDown,
  Clock3,
  File,
  FileText,
  Globe,
  HelpCircle,
  Info,
  MoreHorizontal,
  Plus,
  Search,
  ShieldCheck,
  Stethoscope,
  Trash2,
  UploadCloud,
  X,
} from "lucide-react";

type SourceStatus = "Draft" | "Needs review" | "Indexed" | "Published";
type SourceKind = "Document" | "FAQ" | "Website" | "Clinic details";

type KnowledgeSource = {
  id: number;
  title: string;
  category: string;
  kind: SourceKind;
  status: SourceStatus;
  updated: string;
  details: string;
  size?: string;
};

const initialSources: KnowledgeSource[] = [
  {
    id: 1,
    title: "Clinic hours and location",
    category: "Clinic information",
    kind: "Clinic details",
    status: "Indexed",
    updated: "Demo source",
    details: "Opening hours, address, contact and directions",
  },
  {
    id: 2,
    title: "Consultation fees",
    category: "Pricing",
    kind: "FAQ",
    status: "Needs review",
    updated: "Demo source",
    details: "Consultation charges and payment information",
  },
  {
    id: 3,
    title: "Appointment and cancellation policy",
    category: "Policies",
    kind: "Document",
    status: "Draft",
    updated: "Demo source",
    details: "Booking, cancellation and rescheduling rules",
    size: "PDF / document",
  },
];

const categories = [
  "Clinic information",
  "Doctors and team",
  "Treatments and services",
  "Pricing and payments",
  "Orthodontics",
  "Cosmetic dentistry",
  "Oral surgery",
  "Pediatric dentistry",
  "Insurance",
  "Appointments and policies",
  "Patient FAQs",
  "Emergency information",
  "Other",
];

const statusStyles: Record<SourceStatus, string> = {
  Draft: "bg-slate-100 text-slate-700 ring-slate-200",
  "Needs review": "bg-amber-50 text-amber-800 ring-amber-200",
  Indexed: "bg-blue-50 text-blue-700 ring-blue-200",
  Published: "bg-emerald-50 text-emerald-700 ring-emerald-200",
};

function StatusBadge({ status }: { status: SourceStatus }) {
  return (
    <span
      className={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset ${statusStyles[status]}`}
    >
      <span
        className={`mr-1.5 h-1.5 w-1.5 rounded-full ${
          status === "Published"
            ? "bg-emerald-500"
            : status === "Indexed"
              ? "bg-blue-500"
              : status === "Needs review"
                ? "bg-amber-500"
                : "bg-slate-400"
        }`}
      />
      {status}
    </span>
  );
}

function SectionHeading({
  title,
  description,
}: {
  title: string;
  description?: string;
}) {
  return (
    <div>
      <h2 className="text-base font-semibold text-slate-900">{title}</h2>
      {description && (
        <p className="mt-1 text-sm leading-5 text-slate-500">{description}</p>
      )}
    </div>
  );
}

export default function KnowledgeBasePage() {
  const [sources, setSources] = useState(initialSources);
  const [activeTab, setActiveTab] = useState<
    "upload" | "faq" | "website" | "details"
  >("upload");
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("All sources");
  const [categoryFilter, setCategoryFilter] = useState("All categories");
  const [showAddForm, setShowAddForm] = useState(false);
  const [notice, setNotice] = useState("");
  const [clinicType, setClinicType] = useState("General dentistry");
  const [entryTitle, setEntryTitle] = useState("");
  const [entryCategory, setEntryCategory] = useState("Patient FAQs");
  const [entryContent, setEntryContent] = useState("");
  const [websiteUrl, setWebsiteUrl] = useState("");
  const [clinicName, setClinicName] = useState("");
  const [clinicAddress, setClinicAddress] = useState("");
  const [clinicPhone, setClinicPhone] = useState("");
  const [clinicHours, setClinicHours] = useState("");
  const [files, setFiles] = useState<File[]>([]);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const filteredSources = useMemo(() => {
    const query = search.trim().toLowerCase();

    return sources.filter((source) => {
      const matchesSearch = [
        source.title,
        source.category,
        source.kind,
        source.details,
      ]
        .join(" ")
        .toLowerCase()
        .includes(query);

      const matchesStatus =
        statusFilter === "All sources" || source.status === statusFilter;

      const matchesCategory =
        categoryFilter === "All categories" ||
        source.category === categoryFilter;

      return matchesSearch && matchesStatus && matchesCategory;
    });
  }, [sources, search, statusFilter, categoryFilter]);

  const counts = {
    total: sources.length,
    published: sources.filter((s) => s.status === "Published").length,
    review: sources.filter((s) => s.status === "Needs review").length,
    drafts: sources.filter((s) => s.status === "Draft").length,
  };

  function addSource(
    title: string,
    category: string,
    kind: SourceKind,
    details: string,
    size?: string,
  ) {
    if (!title.trim()) {
      setNotice("Please enter a title first.");
      return false;
    }

    setSources((current) => [
      {
        id: Date.now() + Math.floor(Math.random() * 1000),
        title: title.trim(),
        category,
        kind,
        status: "Draft",
        updated: "Just now",
        details,
        size,
      },
      ...current,
    ]);

    setNotice(
      "Added as a local draft. It has not been uploaded to the clinic database or indexed.",
    );
    setEntryTitle("");
    setEntryContent("");
    setWebsiteUrl("");
    setFiles([]);
    setShowAddForm(false);
    return true;
  }

  function addSelectedFiles() {
    if (files.length === 0) {
      setNotice("Choose at least one document to continue.");
      return;
    }

    const added = files.map((file) => ({
      id: Date.now() + Math.floor(Math.random() * 100000),
      title: file.name,
      category: entryCategory,
      kind: "Document" as const,
      status: "Draft" as const,
      updated: "Just now",
      details:
        "File selected in this browser. Upload, extraction and indexing are not connected yet.",
      size:
        file.size < 1024 * 1024
          ? `${Math.max(1, Math.round(file.size / 1024))} KB`
          : `${(file.size / (1024 * 1024)).toFixed(1)} MB`,
    }));

    setSources((current) => [...added, ...current]);
    setFiles([]);
    if (fileInputRef.current) fileInputRef.current.value = "";
    setShowAddForm(false);
    setNotice(
      "File names added as local drafts only. File contents have not been uploaded or processed.",
    );
  }

  function saveClinicDetails() {
    if (!clinicName.trim()) {
      setNotice("Enter your clinic name first.");
      return;
    }

    const details = [
      clinicAddress && `Address: ${clinicAddress}`,
      clinicPhone && `Phone: ${clinicPhone}`,
      clinicHours && `Hours: ${clinicHours}`,
      `Specialty: ${clinicType}`,
    ]
      .filter(Boolean)
      .join(" • ");

    addSource(
      `${clinicName.trim()} — clinic profile`,
      "Clinic information",
      "Clinic details",
      details || "Clinic profile details",
    );
  }

  function updateStatus(id: number, status: SourceStatus) {
    setSources((current) =>
      current.map((source) =>
        source.id === id ? { ...source, status } : source,
      ),
    );
    setNotice(
      status === "Published"
        ? "Demo status updated locally. This source is not published to the live AI agent."
        : `Demo status changed to ${status}.`,
    );
  }

  function deleteSource(id: number) {
    setSources((current) => current.filter((source) => source.id !== id));
    setNotice("Source removed from this page's temporary state.");
  }

  return (
    <AppShell>
      <div className="mx-auto w-full max-w-[1500px] space-y-6 pb-10">
        <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
          <div>
            <div className="mb-2 flex items-center gap-2 text-sm text-slate-500">
              <BookOpen className="h-4 w-4" />
              <span>AI workspace</span>
              <span>/</span>
              <span className="text-slate-700">Knowledge Base</span>
            </div>

            <h1 className="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
              Knowledge Base
            </h1>

            <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
              Teach your AI receptionist about your clinic, treatments, prices,
              doctors and policies using information your team has approved.
            </p>
          </div>

          <button
            onClick={() => {
              setShowAddForm((value) => !value);
              setNotice("");
            }}
            className="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2"
          >
            <Plus className="h-4 w-4" />
            Add information
          </button>
        </div>

        <div className="flex items-start gap-3 rounded-xl border border-blue-200 bg-blue-50/70 p-4">
          <Info className="mt-0.5 h-5 w-5 shrink-0 text-blue-700" />
          <div>
            <p className="text-sm font-semibold text-blue-950">
              Your clinic&apos;s source of truth
            </p>
            <p className="mt-1 text-sm leading-5 text-blue-900/80">
              Add only accurate, clinic-approved information. The AI should
              answer from approved sources and hand over questions it cannot
              confidently answer.
            </p>
          </div>
        </div>

        {notice && (
          <div
            role="status"
            className="flex items-start justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm"
          >
            <span>{notice}</span>
            <button
              onClick={() => setNotice("")}
              aria-label="Dismiss message"
              className="shrink-0 rounded p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
            >
              <X className="h-4 w-4" />
            </button>
          </div>
        )}

        <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {[
            {
              label: "Total sources",
              value: counts.total,
              note: "Documents and clinic information",
              icon: BookOpen,
            },
            {
              label: "Published to AI",
              value: counts.published,
              note: "Approved sources only",
              icon: ShieldCheck,
            },
            {
              label: "Needs review",
              value: counts.review,
              note: "Check before publishing",
              icon: HelpCircle,
            },
            {
              label: "Drafts",
              value: counts.drafts,
              note: "Not approved for AI answers",
              icon: FileText,
            },
          ].map((stat) => {
            const Icon = stat.icon;

            return (
              <div
                key={stat.label}
                className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
              >
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <p className="text-sm font-medium text-slate-500">
                      {stat.label}
                    </p>
                    <p className="mt-2 text-3xl font-bold tracking-tight text-slate-950">
                      {stat.value}
                    </p>
                  </div>
                  <div className="rounded-xl bg-slate-100 p-2.5 text-slate-700">
                    <Icon className="h-5 w-5" />
                  </div>
                </div>
                <p className="mt-3 text-xs leading-5 text-slate-500">
                  {stat.note}
                </p>
              </div>
            );
          })}
        </div>

        {showAddForm && (
          <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div className="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 sm:px-6">
              <div>
                <h2 className="font-semibold text-slate-950">
                  Add clinic information
                </h2>
                <p className="mt-1 text-sm text-slate-500">
                  Choose the method that is easiest for your team.
                </p>
              </div>
              <button
                onClick={() => setShowAddForm(false)}
                aria-label="Close add information"
                className="rounded-lg p-2 text-slate-500 hover:bg-slate-100"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="grid gap-2 border-b border-slate-200 bg-slate-50/70 p-3 sm:grid-cols-4">
              {[
                { id: "upload", label: "Upload documents", icon: UploadCloud },
                { id: "faq", label: "Add FAQ", icon: HelpCircle },
                { id: "website", label: "Website URL", icon: Globe },
                { id: "details", label: "Clinic profile", icon: Stethoscope },
              ].map((tab) => {
                const Icon = tab.icon;
                const active = activeTab === tab.id;

                return (
                  <button
                    key={tab.id}
                    onClick={() =>
                      setActiveTab(
                        tab.id as "upload" | "faq" | "website" | "details",
                      )
                    }
                    className={`flex items-center justify-center gap-2 rounded-xl px-3 py-3 text-sm font-medium transition ${
                      active
                        ? "border border-slate-200 bg-white text-slate-950 shadow-sm"
                        : "text-slate-600 hover:bg-white hover:text-slate-900"
                    }`}
                  >
                    <Icon className="h-4 w-4" />
                    {tab.label}
                  </button>
                );
              })}
            </div>

            <div className="space-y-5 p-5 sm:p-6">
              {activeTab === "upload" && (
                <>
                  <div>
                    <label
                      htmlFor="document-category"
                      className="mb-2 block text-sm font-medium text-slate-800"
                    >
                      What is this document about?
                    </label>
                    <select
                      id="document-category"
                      value={entryCategory}
                      onChange={(e) => setEntryCategory(e.target.value)}
                      className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200 sm:max-w-md"
                    >
                      {categories.map((category) => (
                        <option key={category}>{category}</option>
                      ))}
                    </select>
                  </div>

                  <button
                    type="button"
                    onClick={() => fileInputRef.current?.click()}
                    onDragOver={(e) => e.preventDefault()}
                    onDrop={(e) => {
                      e.preventDefault();
                      const incoming = Array.from(e.dataTransfer.files);
                      setFiles((current) => [...current, ...incoming]);
                    }}
                    className="flex w-full flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/70 px-5 py-10 text-center transition hover:border-slate-500 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400"
                  >
                    <div className="mb-4 rounded-2xl bg-white p-3 text-slate-700 shadow-sm ring-1 ring-slate-200">
                      <UploadCloud className="h-7 w-7" />
                    </div>
                    <p className="text-sm font-semibold text-slate-900">
                      Click to choose files or drag them here
                    </p>
                    <p className="mt-2 max-w-lg text-sm leading-5 text-slate-500">
                      Useful examples: clinic brochures, treatment lists, price
                      lists, consent information, policies and patient FAQs.
                    </p>
                    <p className="mt-3 text-xs text-slate-500">
                      PDF, DOC, DOCX, TXT, MD and CSV
                    </p>
                  </button>

                  <input
                    ref={fileInputRef}
                    type="file"
                    multiple
                    accept=".pdf,.doc,.docx,.txt,.md,.csv"
                    className="hidden"
                    onChange={(e) =>
                      setFiles((current) => [
                        ...current,
                        ...Array.from(e.target.files ?? []),
                      ])
                    }
                  />

                  {files.length > 0 && (
                    <div className="space-y-2">
                      <p className="text-sm font-medium text-slate-800">
                        Selected files ({files.length})
                      </p>
                      {files.map((file, index) => (
                        <div
                          key={`${file.name}-${index}`}
                          className="flex items-center gap-3 rounded-xl border border-slate-200 p-3"
                        >
                          <FileText className="h-5 w-5 shrink-0 text-slate-600" />
                          <div className="min-w-0 flex-1">
                            <p className="truncate text-sm font-medium text-slate-800">
                              {file.name}
                            </p>
                            <p className="text-xs text-slate-500">
                              {(file.size / 1024).toFixed(0)} KB
                            </p>
                          </div>
                          <button
                            onClick={() =>
                              setFiles((current) =>
                                current.filter((_, i) => i !== index),
                              )
                            }
                            aria-label={`Remove ${file.name}`}
                            className="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-red-600"
                          >
                            <X className="h-4 w-4" />
                          </button>
                        </div>
                      ))}
                    </div>
                  )}

                  <div className="flex flex-col justify-end gap-2 sm:flex-row">
                    <button
                      onClick={() => setShowAddForm(false)}
                      className="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                    >
                      Cancel
                    </button>
                    <button
                      onClick={addSelectedFiles}
                      className="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800"
                    >
                      Add selected files as drafts
                    </button>
                  </div>
                  <p className="text-xs leading-5 text-slate-500">
                    Prototype only: this records file names in temporary page
                    state. The files themselves are not uploaded or indexed.
                  </p>
                </>
              )}

              {activeTab === "faq" && (
                <form
                  className="space-y-4"
                  onSubmit={(e) => {
                    e.preventDefault();
                    if (!entryContent.trim()) {
                      setNotice("Enter the answer or information first.");
                      return;
                    }
                    addSource(
                      entryTitle,
                      entryCategory,
                      "FAQ",
                      entryContent.trim(),
                    );
                  }}
                >
                  <div className="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label
                        htmlFor="faq-title"
                        className="mb-2 block text-sm font-medium text-slate-800"
                      >
                        Question or title
                      </label>
                      <input
                        id="faq-title"
                        value={entryTitle}
                        onChange={(e) => setEntryTitle(e.target.value)}
                        placeholder="e.g. Do you offer clear aligners?"
                        className="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                      />
                    </div>
                    <div>
                      <label
                        htmlFor="faq-category"
                        className="mb-2 block text-sm font-medium text-slate-800"
                      >
                        Category
                      </label>
                      <select
                        id="faq-category"
                        value={entryCategory}
                        onChange={(e) => setEntryCategory(e.target.value)}
                        className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                      >
                        {categories.map((category) => (
                          <option key={category}>{category}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                  <div>
                    <label
                      htmlFor="faq-answer"
                      className="mb-2 block text-sm font-medium text-slate-800"
                    >
                      Approved answer or information
                    </label>
                    <textarea
                      id="faq-answer"
                      value={entryContent}
                      onChange={(e) => setEntryContent(e.target.value)}
                      rows={5}
                      placeholder="Write the answer your team wants the AI receptionist to use. Include confirmed details only."
                      className="w-full rounded-xl border border-slate-300 px-3 py-3 text-sm leading-6 outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                    />
                  </div>
                  <div className="flex justify-end">
                    <button className="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
                      Save as draft
                    </button>
                  </div>
                </form>
              )}

              {activeTab === "website" && (
                <form
                  className="space-y-4"
                  onSubmit={(e) => {
                    e.preventDefault();
                    if (!websiteUrl.trim()) {
                      setNotice("Enter a website URL first.");
                      return;
                    }
                    let validUrl: URL;
                    try {
                      validUrl = new URL(websiteUrl.trim());
                    } catch {
                      setNotice("Enter a valid URL beginning with https://.");
                      return;
                    }
                    if (!["https:", "http:"].includes(validUrl.protocol)) {
                      setNotice("Only HTTP and HTTPS URLs are supported.");
                      return;
                    }
                    addSource(
                      validUrl.hostname,
                      "Clinic information",
                      "Website",
                      validUrl.href,
                    );
                  }}
                >
                  <div>
                    <label
                      htmlFor="website-url"
                      className="mb-2 block text-sm font-medium text-slate-800"
                    >
                      Clinic website URL
                    </label>
                    <input
                      id="website-url"
                      type="url"
                      value={websiteUrl}
                      onChange={(e) => setWebsiteUrl(e.target.value)}
                      placeholder="https://yourclinic.com/services"
                      className="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                    />
                    <p className="mt-2 text-xs leading-5 text-slate-500">
                      Use a page your clinic owns or is authorized to use.
                      Website crawling and content extraction are not connected
                      yet.
                    </p>
                  </div>
                  <div className="flex justify-end">
                    <button className="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
                      Add URL as draft
                    </button>
                  </div>
                </form>
              )}

              {activeTab === "details" && (
                <form
                  className="space-y-4"
                  onSubmit={(e) => {
                    e.preventDefault();
                    saveClinicDetails();
                  }}
                >
                  <div>
                    <label
                      htmlFor="clinic-type"
                      className="mb-2 block text-sm font-medium text-slate-800"
                    >
                      Clinic specialty
                    </label>
                    <select
                      id="clinic-type"
                      value={clinicType}
                      onChange={(e) => setClinicType(e.target.value)}
                      className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200 sm:max-w-md"
                    >
                      {[
                        "General dentistry",
                        "Orthodontics",
                        "Cosmetic dentistry",
                        "Pediatric dentistry",
                        "Oral and maxillofacial surgery",
                        "Periodontics",
                        "Endodontics",
                        "Prosthodontics",
                        "Multi-specialty dental clinic",
                        "Other healthcare clinic",
                      ].map((specialty) => (
                        <option key={specialty}>{specialty}</option>
                      ))}
                    </select>
                  </div>

                  <div className="grid gap-4 sm:grid-cols-2">
                    {[
                      {
                        id: "clinic-name",
                        label: "Clinic name *",
                        value: clinicName,
                        set: setClinicName,
                        placeholder: "e.g. Smile Dental Clinic",
                      },
                      {
                        id: "clinic-phone",
                        label: "Contact number",
                        value: clinicPhone,
                        set: setClinicPhone,
                        placeholder: "Clinic phone number",
                      },
                      {
                        id: "clinic-address",
                        label: "Clinic address",
                        value: clinicAddress,
                        set: setClinicAddress,
                        placeholder: "Full address and landmark",
                      },
                      {
                        id: "clinic-hours",
                        label: "Opening hours",
                        value: clinicHours,
                        set: setClinicHours,
                        placeholder: "e.g. Mon–Sat, 9 AM–7 PM",
                      },
                    ].map((field) => (
                      <div key={field.id}>
                        <label
                          htmlFor={field.id}
                          className="mb-2 block text-sm font-medium text-slate-800"
                        >
                          {field.label}
                        </label>
                        <input
                          id={field.id}
                          value={field.value}
                          onChange={(e) => field.set(e.target.value)}
                          placeholder={field.placeholder}
                          className="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                        />
                      </div>
                    ))}
                  </div>
                  <div className="flex justify-end">
                    <button className="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
                      Add clinic profile as draft
                    </button>
                  </div>
                </form>
              )}
            </div>
          </section>
        )}

        <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div className="flex flex-col justify-between gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:px-6">
            <div>
              <SectionHeading
                title="Knowledge sources"
                description="Find, review and organize information associated with your clinic."
              />
            </div>
            <div className="flex flex-wrap items-center gap-2">
              <div className="relative min-w-0 flex-1 sm:w-64 sm:flex-none">
                <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Search sources..."
                  aria-label="Search knowledge sources"
                  className="w-full rounded-xl border border-slate-300 py-2.5 pl-9 pr-3 text-sm outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
                />
              </div>
              <select
                value={statusFilter}
                onChange={(e) => setStatusFilter(e.target.value)}
                aria-label="Filter by status"
                className="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 outline-none focus:border-slate-500"
              >
                {[
                  "All sources",
                  "Draft",
                  "Needs review",
                  "Indexed",
                  "Published",
                ].map((status) => (
                  <option key={status}>{status}</option>
                ))}
              </select>
            </div>
          </div>

          <div className="border-b border-slate-200 px-5 py-3 sm:px-6">
            <div className="flex flex-wrap items-center gap-2">
              <span className="mr-1 text-xs font-medium text-slate-500">
                Category
              </span>
              <button
                onClick={() => setCategoryFilter("All categories")}
                className={`rounded-full px-3 py-1.5 text-xs font-medium transition ${
                  categoryFilter === "All categories"
                    ? "bg-slate-900 text-white"
                    : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                }`}
              >
                All
              </button>
              {[
                "Clinic information",
                "Treatments and services",
                "Pricing and payments",
                "Appointments and policies",
                "Patient FAQs",
              ].map((category) => (
                <button
                  key={category}
                  onClick={() => setCategoryFilter(category)}
                  className={`rounded-full px-3 py-1.5 text-xs font-medium transition ${
                    categoryFilter === category
                      ? "bg-slate-900 text-white"
                      : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                  }`}
                >
                  {category}
                </button>
              ))}
              <div className="relative ml-auto">
                <label htmlFor="all-category-filter" className="sr-only">
                  All categories
                </label>
                <select
                  id="all-category-filter"
                  value={categoryFilter}
                  onChange={(e) => setCategoryFilter(e.target.value)}
                  className="max-w-[170px] rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-600 outline-none focus:border-slate-400"
                >
                  <option>All categories</option>
                  {categories.map((category) => (
                    <option key={category}>{category}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>

          {filteredSources.length === 0 ? (
            <div className="flex flex-col items-center px-5 py-14 text-center">
              <div className="rounded-2xl bg-slate-100 p-4 text-slate-600">
                <BookOpen className="h-7 w-7" />
              </div>
              <h3 className="mt-4 text-base font-semibold text-slate-900">
                No matching sources
              </h3>
              <p className="mt-1 max-w-md text-sm leading-6 text-slate-500">
                Try another search or filter, or add clinic information to get
                started.
              </p>
              <button
                onClick={() => {
                  setSearch("");
                  setStatusFilter("All sources");
                  setCategoryFilter("All categories");
                }}
                className="mt-4 text-sm font-semibold text-slate-800 underline underline-offset-4"
              >
                Clear filters
              </button>
            </div>
          ) : (
            <>
              <div className="hidden grid-cols-[minmax(0,1.7fr)_minmax(130px,0.8fr)_minmax(130px,0.8fr)_minmax(100px,0.6fr)_40px] gap-4 bg-slate-50/70 px-6 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 md:grid">
                <span>Source</span>
                <span>Category</span>
                <span>Status</span>
                <span>Updated</span>
                <span />
              </div>

              <div className="divide-y divide-slate-100">
                {filteredSources.map((source) => (
                  <div
                    key={source.id}
                    className="grid gap-3 px-5 py-4 transition hover:bg-slate-50/70 md:grid-cols-[minmax(0,1.7fr)_minmax(130px,0.8fr)_minmax(130px,0.8fr)_minmax(100px,0.6fr)_40px] md:items-center md:gap-4 md:px-6"
                  >
                    <div className="flex min-w-0 items-start gap-3">
                      <div className="mt-0.5 rounded-xl border border-slate-200 bg-white p-2.5 text-slate-600">
                        {source.kind === "Website" ? (
                          <Globe className="h-4 w-4" />
                        ) : source.kind === "FAQ" ? (
                          <HelpCircle className="h-4 w-4" />
                        ) : source.kind === "Clinic details" ? (
                          <Stethoscope className="h-4 w-4" />
                        ) : (
                          <FileText className="h-4 w-4" />
                        )}
                      </div>
                      <div className="min-w-0">
                        <p className="break-words text-sm font-semibold text-slate-900">
                          {source.title}
                        </p>
                        <p className="mt-1 break-words text-xs leading-5 text-slate-500">
                          {source.details}
                        </p>
                        <p className="mt-1 text-xs text-slate-400">
                          {source.kind}
                          {source.size ? ` · ${source.size}` : ""}
                        </p>
                      </div>
                    </div>

                    <div>
                      <span className="mb-1 block text-xs text-slate-400 md:hidden">
                        Category
                      </span>
                      <span className="text-sm text-slate-600">
                        {source.category}
                      </span>
                    </div>

                    <div>
                      <span className="mb-1 block text-xs text-slate-400 md:hidden">
                        Status
                      </span>
                      <StatusBadge status={source.status} />
                    </div>

                    <div className="text-xs text-slate-500">
                      <span className="mb-1 block text-xs text-slate-400 md:hidden">
                        Updated
                      </span>
                      {source.updated}
                    </div>

                    <div className="flex items-center gap-2 md:justify-end">
                      <label className="sr-only" htmlFor={`status-${source.id}`}>
                        Change status for {source.title}
                      </label>
                      <select
                        id={`status-${source.id}`}
                        value={source.status}
                        onChange={(e) =>
                          updateStatus(
                            source.id,
                            e.target.value as SourceStatus,
                          )
                        }
                        className="max-w-[150px] rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-600 outline-none focus:border-slate-400"
                      >
                        {(
                          [
                            "Draft",
                            "Needs review",
                            "Indexed",
                            "Published",
                          ] as SourceStatus[]
                        ).map((status) => (
                          <option key={status}>{status}</option>
                        ))}
                      </select>
                      <button
                        onClick={() => deleteSource(source.id)}
                        title="Remove source"
                        aria-label={`Remove ${source.title}`}
                        className="rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                      >
                        <Trash2 className="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}

          <div className="flex flex-col justify-between gap-2 border-t border-slate-200 bg-slate-50/60 px-5 py-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:px-6">
            <span>
              Showing {filteredSources.length} of {sources.length} sources
            </span>
            <span>Prototype data · not synced with the server</span>
          </div>
        </section>

        <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div className="flex items-start gap-3">
            <div className="rounded-xl bg-slate-100 p-2.5 text-slate-700">
              <Activity className="h-5 w-5" />
            </div>
            <div className="min-w-0 flex-1">
              <h2 className="font-semibold text-slate-950">
                Prepare knowledge for your AI receptionist
              </h2>
              <p className="mt-1 text-sm leading-6 text-slate-600">
                Before a source is used in patient conversations, verify its
                accuracy, confirm that pricing and policies are current, and
                publish it through the server-backed approval workflow.
              </p>
              <div className="mt-4 grid gap-3 sm:grid-cols-3">
                {[
                  {
                    icon: FileText,
                    title: "Add",
                    description: "Bring in clinic-approved information.",
                  },
                  {
                    icon: ShieldCheck,
                    title: "Review",
                    description: "Verify details and approve the source.",
                  },
                  {
                    icon: Check,
                    title: "Publish",
                    description: "Make approved content available to the AI.",
                  },
                ].map((step) => {
                  const Icon = step.icon;
                  return (
                    <div
                      key={step.title}
                      className="rounded-xl border border-slate-200 p-4"
                    >
                      <Icon className="h-5 w-5 text-slate-600" />
                      <p className="mt-3 text-sm font-semibold text-slate-900">
                        {step.title}
                      </p>
                      <p className="mt-1 text-xs leading-5 text-slate-500">
                        {step.description}
                      </p>
                    </div>
                  );
                })}
              </div>
              <p className="mt-4 flex items-start gap-2 text-xs leading-5 text-slate-500">
                <Clock3 className="mt-0.5 h-4 w-4 shrink-0" />
                Document processing, search indexing, version history and
                live-agent publishing will become active when connected to the
                backend.
              </p>
            </div>
          </div>
        </section>
      </div>
    </AppShell>
  );
}
