"use client";
import { useState } from "react";
import { Panel, Stat, Pill, WorkspacePage } from "@/components/ai-os/WorkspacePage";
const initial=[{id:1,title:"Clinic hours and location",type:"Clinic information",status:"Indexed"},{id:2,title:"Consultation fees",type:"Pricing",status:"Needs review"},{id:3,title:"Appointment and cancellation policy",type:"Policies",status:"Draft"}];
export default function Page(){const [items,setItems]=useState(initial);const [title,setTitle]=useState("");const [type,setType]=useState("FAQ");const [q,setQ]=useState("");const [msg,setMsg]=useState("");const filtered=items.filter(x=>(x.title+x.type).toLowerCase().includes(q.toLowerCase()));return <WorkspacePage title="Knowledge Base" description="Manage clinic-approved FAQs, services, prices, hours, policies and documents."><div className="grid gap-4 sm:grid-cols-3"><Stat label="Knowledge entries" value={String(items.length)}/><Stat label="Indexed" value={String(items.filter(x=>x.status==="Indexed").length)}/><Stat label="Needs review" value={String(items.filter(x=>x.status==="Needs review").length)}/></div><Panel title="Add knowledge entry"><div className="grid gap-3 md:grid-cols-[1fr_200px_auto]"><input value={title} onChange={e=>setTitle(e.target.value)} placeholder="Entry title" className="rounded-lg border px-3 py-2"/><select value={type} onChange={e=>setType(e.target.value)} className="rounded-lg border px-3 py-2">{["FAQ","Clinic information","Services","Pricing","Policies","Doctor profile"].map(x=><option key={x}>{x}</option>)}</select><button onClick={()=>{if(!title.trim()){setMsg("Enter a title.");return;}setItems([{id:Date.now(),title:title.trim(),type,status:"Draft"},...items]);setTitle("");setMsg("Added to temporary page state only; not saved to server.");}} className="rounded-lg bg-slate-900 px-4 py-2 text-white">Add draft</button></div>{msg&&<p className="mt-3 text-sm text-slate-600">{msg}</p>}<p className="mt-2 text-xs text-slate-500">Document upload, indexing, retrieval testing and publishing need backend integration.</p></Panel><Panel title="Sources"><input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search sources..." className="mb-3 w-full rounded-lg border px-3 py-2"/><div className="space-y-2">{filtered.map(x=><div key={x.id} className="flex items-center justify-between gap-3 rounded-xl border p-3"><div><p className="font-medium">{x.title}</p><p className="text-sm text-slate-500">{x.type}</p></div><div className="flex items-center gap-2"><Pill>{x.status}</Pill><button onClick={()=>setItems(items.filter(y=>y.id!==x.id))} className="text-sm text-red-600">Delete</button></div></div>)}</div></Panel></WorkspacePage>}
