"use client";
import { useState } from "react";
import { Panel, Stat, Pill, WorkspacePage } from "@/components/ai-os/WorkspacePage";
const calls=[{id:"CALL-DEMO-001",caller:"Demo caller ending 0182",duration:"02:40",language:"Marathi",outcome:"Appointment booked",summary:"Caller asked for a consultation. Real booking success must be verified by the booking API.",turns:[["Patient","मला दातांच्या तपासणीसाठी अपॉइंटमेंट हवी आहे."],["AI receptionist","नक्की. तुम्हाला कोणत्या दिवशी यायचे आहे?"],["Patient","उद्या संध्याकाळी."],["AI receptionist","मी उपलब्ध वेळ तपासते."]]},{id:"CALL-DEMO-002",caller:"Unknown caller",duration:"00:54",language:"English",outcome:"Needs staff review",summary:"Demo call requiring staff follow-up.",turns:[["Patient","Can someone call me back?"],["AI receptionist","I will flag this for the clinic team."]]}];
export default function Page(){const [active,setActive]=useState(calls[0]);const [q,setQ]=useState("");const filtered=calls.filter(c=>(c.id+c.caller+c.outcome).toLowerCase().includes(q.toLowerCase()));return <WorkspacePage title="Call History & Transcripts" description="Review AI calls, speaker-labelled transcripts, summaries, outcomes and staff follow-up."><div className="grid gap-4 sm:grid-cols-3"><Stat label="Calls (demo)" value="2"/><Stat label="Booked outcome (demo)" value="1"/><Stat label="Needs review (demo)" value="1"/></div><div className="grid gap-4 lg:grid-cols-2"><Panel title="Calls"><input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search calls..." className="mb-3 w-full rounded-lg border px-3 py-2"/><div className="space-y-2">{filtered.map(c=><button key={c.id} onClick={()=>setActive(c)} className={`w-full rounded-xl border p-3 text-left ${active.id===c.id?"border-slate-900 bg-slate-50":"border-slate-200"}`}><p className="font-medium">{c.caller}</p><p className="text-xs text-slate-500">{c.id} · {c.duration}</p><div className="mt-2"><Pill>{c.outcome}</Pill></div></button>)}</div></Panel><Panel title="Call details"><h3 className="font-semibold">{active.id}</h3><p className="text-sm text-slate-500">{active.language} · {active.duration}</p><div className="my-4"><Pill>{active.outcome}</Pill></div><h4 className="mb-2 text-sm font-semibold">Summary</h4><p className="mb-4 text-sm text-slate-600">{active.summary}</p><h4 className="mb-2 text-sm font-semibold">Transcript</h4><div className="space-y-2">{active.turns.map((t,i)=><div key={i} className={`rounded-xl p-3 ${t[0]==="AI receptionist"?"bg-blue-50":"bg-slate-100"}`}><p className="text-xs font-semibold text-slate-500">{t[0]}</p><p className="text-sm">{t[1]}</p></div>)}</div><p className="mt-3 text-xs text-slate-500">Illustrative demo only. Audio, real calls and booking links need backend integration.</p></Panel></div></WorkspacePage>}
